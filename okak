local flyBV = nil
local flyBG = nil
local flying = false

local function startFly()
    if flying then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = true end
    flying = true
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
    flyBV.Velocity = Vector3.new(0,0,0)
    flyBV.Parent = hrp
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
    flyBG.D = 200
    flyBG.P = 40000
    flyBG.Parent = hrp
end

local function stopFly()
    if not flying then return end
    flying = false
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    local char = lp.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local xrayOn = false
local xrayData = {}

local espConns = {}

local function makeESP(plr)
    if plr == lp then return end
    local function setup(char)
        if not char then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        if not hrp then return end
        for _,old in ipairs(char:GetChildren()) do
            if old.Name == "DHL" or old.Name == "DBB" then old:Destroy() end
        end
        local hl = Instance.new("Highlight")
        hl.Name = "DHL"
        hl.FillColor = getgenv().Cfg.color
        hl.FillTransparency = 0.65
        hl.OutlineColor = Color3.new(1,1,1)
        hl.OutlineTransparency = 0
        hl.Adornee = char
        hl.Parent = char
        local bbg = Instance.new("BillboardGui")
        bbg.Name = "DBB"
        bbg.Adornee = hrp
        bbg.Size = UDim2.new(0,200,0,50)
        bbg.StudsOffset = Vector3.new(0,3,0)
        bbg.AlwaysOnTop = true
        bbg.Parent = char
        local tl = Instance.new("TextLabel", bbg)
        tl.Size = UDim2.new(1,0,1,0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = Color3.new(1,1,1)
        tl.TextStrokeTransparency = 0
        tl.TextStrokeColor3 = Color3.new(0,0,0)
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 13
        if espConns[plr] then espConns[plr]:Disconnect() end
        espConns[plr] = RunService.RenderStepped:Connect(function()
            if not char or not char.Parent or not hrp or not hrp.Parent then
                if espConns[plr] then espConns[plr]:Disconnect() espConns[plr]=nil end
                return
            end
            hl.Enabled = getgenv().Cfg.high
            hl.FillColor = getgenv().Cfg.color
            bbg.Enabled = getgenv().Cfg.esp
            local myhrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if myhrp then
                tl.Text = plr.Name.."\n["..math.floor((myhrp.Position-hrp.Position).Magnitude).." studs]"
            else
                tl.Text = plr.Name
            end
        end)
    end
    if plr.Character then task.spawn(function() setup(plr.Character) end) end
    plr.CharacterAdded:Connect(function(c) task.wait(1) setup(c) end)
end

for _,v in ipairs(Players:GetPlayers()) do task.spawn(function() makeESP(v) end) end
Players.PlayerAdded:Connect(function(p) makeESP(p) end)
Players.PlayerRemoving:Connect(function(p)
