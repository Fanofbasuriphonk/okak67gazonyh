local function e(plr)
    local function create()
        if plr == lp then return end
        local char = plr.Character or plr.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        
        local h = Instance.new("Highlight")
        h.Parent = char
        
        local bg = Instance.new("BillboardGui")
        bg.Size = UDim2.new(0, 200, 0, 50)
        bg.Adornee = hrp
        bg.AlwaysOnTop = true
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.Parent = char
        
        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = Color3.new(1, 1, 1)
        tl.Parent = bg
        
        r.RenderStepped:Connect(function()
            if char and char:Parent and hrp and hrp.Parent then
                h.Enabled = getgenv().S.E and getgenv().S.H
                tl.Visible = getgenv().S.E
                local dist = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and math.floor((hrp.Position - lp.Character.HumanoidRootPart.Position).Magnitude) or 0
                tl.Text = plr.Name .. " [" .. dist .. "]"
            else
                h:Destroy()
                bg:Destroy()
            end
        end)
    end
    create()
    plr.CharacterAdded:Connect(create)
end

for _, v in pairs(p:GetPlayers()) do e(v) end
