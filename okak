local function make_input(name, key, min, max)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 60)
    f.BackgroundTransparency = 1
    f.Parent = scroll
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 25)
    l.Text = name .. ": " .. getgenv().Config[key]
    l.TextColor3 = Color3.new(1, 1, 1)
    l.BackgroundTransparency = 1
    l.Parent = f
    
    local i = Instance.new("TextBox")
    i.Size = UDim2.new(1, -20, 0, 30)
    i.Position = UDim2.new(0, 10, 0, 25)
    i.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    i.Text = tostring(getgenv().Config[key])
    i.TextColor3 = Color3.new(1, 1, 1)
    i.Parent = f
    Instance.new("UICorner", i)
    
    i.FocusLost:Connect(function()
        local v = tonumber(i.Text)
        if v then
            v = math.clamp(v, min, max)
            getgenv().Config[key] = v
            l.Text = name .. ": " .. v
        end
    end)
end

local function make_toggle(name, key)
    local t = Instance.new("TextButton")
    t.Size = UDim2.new(1, 0, 0, 40)
    t.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    t.Text = name .. ": " .. tostring(getgenv().Config[key])
    t.TextColor3 = Color3.new(1, 1, 1)
    t.Parent = scroll
    Instance.new("UICorner", t)
    
    t.MouseButton1Click:Connect(function()
        getgenv().Config[key] = not getgenv().Config[key]
        t.Text = name .. ": " .. tostring(getgenv().Config[key])
    end)
end

make_input("WalkSpeed", "WS", 16, 500)
