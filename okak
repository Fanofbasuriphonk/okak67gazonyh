local function makeESP(plr)
    if plr == lp then return end
    local function setup(char)
        if not char then return end
        local hrp = char:WaitForChild("HumanoidRootPart",10)
        if not hrp then return end
        for _,old in ipairs(char:GetChildren()) do
            if old.Name == "DHL" or old.Name == "DBB" then old:Destroy() end
        end
        local hl = Instance.new("Highlight")
        hl.Name = "DHL"
        hl.FillColor = getgenv().Cfg.color
        hl.FillTransparency = 0.65
        hl.OutlineColor = Color3.new(1,1,1)
        hl.Adornee = char
        hl.Parent = char
        local bbg = Instance.new("BillboardGui")
        bbg.Name = "DBB"
        bbg.Adornee = hrp
        bbg.Size = UDim2.new(0,200,0,50)
        bbg.StudsOffset = Vector3.new(0,3,0)
        bbg.AlwaysOnTop = true
        bbg.Parent = char
        local tl = Instance.new("TextLabel",bbg)
        tl.Size = UDim2.new(1,0,1,0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = Color3.new(1,1,1)
        tl.TextStrokeTransparency = 0
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 13
        if espConns[plr] then espConns[plr]:Disconnect() end
        espConns[plr] = RunService.RenderStepped:Connect(function()
            if not char or not char.Parent or not hrp or not hrp.Parent then
                if espConns[plr] then espConns[plr]:Disconnect() espConns[plr]=nil end
                return
            end
            hl.Enabled = getgenv().Cfg.high
            hl.FillColor = getgenv().Cfg.color
            bbg.Enabled = getgenv().Cfg.esp
            local myhrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if myhrp then
                tl.Text = plr.Name.."\n["..math.floor((myhrp.Position-hrp.Position).Magnitude).." studs]"
            else
                tl.Text = plr.Name
            end
        end)
    end
    if plr.Character then task.spawn(function() setup(plr.Character) end) end
    plr.CharacterAdded:Connect(function(c) task.wait(1) setup(c) end)
end

for _,v in ipairs(Players:GetPlayers()) do task.spawn(function() makeESP(v) end) end
Players.PlayerAdded:Connect(function(p) makeESP(p) end)
Players.PlayerRemoving:Connect(function(p) if espConns[p] then espConns[p]:Disconnect() espConns[p]=nil end end)

RunService.Stepped:Connect(function()
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and not flying then
        hum.WalkSpeed = getgenv().Cfg.ws
        hum.JumpPower = getgenv().Cfg.jp
        hum.UseJumpPower = true
    end
    workspace.CurrentCamera.FieldOfView = getgenv().Cfg.fov
    if getgenv().Cfg.noclip then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if getgenv().Cfg.fly and flying and flyBV and flyBG then
        local char = lp.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp then return end

        local cam = workspace.CurrentCamera
        local speed = getgenv().Cfg.flyspeed
        local dir = Vector3.new(0,0,0)
        local camLook = cam.CFrame.LookVector
        local camRight = cam.CFrame.RightVector

        if hum and hum.MoveDirection.Magnitude > 0 then
            local md = hum.MoveDirection
            dir = (camLook * Vector3.new(1,0,1)).Unit * md.Z + (camRight * Vector3.new(1,0,1)).Unit * md.X
        end

        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + camLook end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - camLook end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - camRight end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + camRight end
        if wantUp then dir = dir + Vector3.new(0,1,0) end
        if wantDown then dir = dir - Vector3.new(0,1,0) end

        local target = Vector3.new(0,0,0)
        if dir.Magnitude > 0 then
            target = dir.Unit * speed
        end

        smoothVel = smoothVel:Lerp(target, 0.15)
        flyBV.Velocity = smoothVel
        flyBG.CFrame = cam.CFrame
    end
end)

RunService.Heartbeat:Connect(function()
    if getgenv().Cfg.fps then
        if setfpscap then setfpscap(120) end
    else
        if setfpscap then setfpscap(60) end
    end

    if getgenv().Cfg.fly then
        if not flying then startFly() end
    else
        if flying then stopFly() end
    end

    if getgenv().Cfg.fling then
        if not flingConn then startFling() end
    else
        if flingConn then stopFling() end
    end

    local char = lp.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and getgenv().Cfg.antivoid then
            if hrp.Position.Y < -50 then
                hrp.CFrame = CFrame.new(hrp.Position.X,100,hrp.Position.Z)
                hrp.Velocity = Vector3.new(0,0,0)
            end
        end
    end

    if getgenv().Cfg.xray and not xrayOn then
        xrayOn = true
        xrayData = {}
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local skip = false
                for _,pl in ipairs(Players:GetPlayers()) do
                    if pl.Character and obj:IsDescendantOf(pl.Character) then skip = true break end
                end
                if not skip and obj.Transparency < 0.75 then
                    table.insert(xrayData,{obj,obj.Transparency})
                    obj.Transparency = 0.75
                end
            end
        end
    elseif not getgenv().Cfg.xray and xrayOn then
        xrayOn = false
        for _,d in ipairs(xrayData) do
            if d[1] and d[1].Parent then d[1].Transparency = d[2] end
        end
        xrayData = {}
    end
end)

