-- NoClip
local noclipcon
noclipcon = RunService.Stepped:Connect(function()
    if getgenv().Config.NoClip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Xray
local xraycon
local xrayparts = {}
xraycon = RunService.Heartbeat:Connect(function()
    if getgenv().Config.Xray then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                for _, obj in pairs(plr.Character:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Transparency < 0.7 then
                        obj.Transparency = 0.7
                        table.insert(xrayparts, obj)
                    end
                end
            end
        end
    else
        for _, part in pairs(xrayparts) do
            if part and part.Parent then
                part.Transparency = 0
            end
        end
        xrayparts = {}
    end
end)

-- ESP
local esp = {}
local function addesp(plr)
    if plr == LocalPlayer then return end
    local function create()
        local char = plr.Character or plr.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart")
        local highlight = Instance.new("Highlight", char)
        highlight.FillColor = Color3.fromRGB(0, 170, 255)
        highlight.FillTransparency = 0.75
        
        local bill = Instance.new("BillboardGui", char)
        bill.Adornee = root
        bill.Size = UDim2.new(0, 200, 0, 60)
        bill.AlwaysOnTop = true
        bill.StudsOffset = Vector3.new(0, 3.5, 0)
        
        local text = Instance.new("TextLabel", bill)
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.TextColor3 = Color3.new(1, 1, 1)
        text.TextStrokeTransparency = 0
        text.Font = Enum.Font.GothamBold
        text.TextSize = 13
        
        RunService.RenderStepped:Connect(function()
            if not char or not char.Parent then return end
            highlight.Enabled = getgenv().Config.High
            text.Visible = getgenv().Config.ESP
            local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) and math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude) or 0
            text.Text = plr.Name .. "\n[" .. dist .. "s]"
        end)
    end
    create()
    plr.CharacterAdded:Connect(create)
end

for _, p in pairs(Players:GetPlayers()) do addesp(p) end
Players.PlayerAdded:Connect(addesp)

