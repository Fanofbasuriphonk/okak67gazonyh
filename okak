local function s(n, mi, ma, st, k)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 50)
    f.BackgroundTransparency = 1
    f.Parent = sc
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 20)
    l.Text = n .. ": " .. getgenv().S[k]
    l.TextColor3 = Color3.new(1, 1, 1)
    l.BackgroundTransparency = 1
    l.Parent = f
    
    local i = Instance.new("TextBox")
    i.Size = UDim2.new(1, 0, 0, 25)
    i.Position = UDim2.new(0, 0, 0, 20)
    i.Text = tostring(getgenv().S[k])
    i.Parent = f
    
    i.FocusLost:Connect(function()
        local v = tonumber(i.Text)
        if v then
            v = math.clamp(v, mi, ma)
            getgenv().S[k] = v
            l.Text = n .. ": " .. v
        end
    end)
end

local function bt(n, k)
    local tb = Instance.new("TextButton")
