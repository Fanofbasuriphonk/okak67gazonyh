    local function upd()
        if getgenv().Cfg[key] then
            b.BackgroundColor3 = Color3.fromRGB(0,160,80)
            b.Text = name.." ● ON"
        else
            b.BackgroundColor3 = Color3.fromRGB(40,40,50)
            b.Text = name.." ○ OFF"
        end
    end
    upd()

    b.MouseButton1Click:Connect(function()
        getgenv().Cfg[key] = not getgenv().Cfg[key]
        upd()
    end)
end

