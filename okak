RunService.Stepped:Connect(function()
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if hum and not getgenv().Cfg.fly then
        hum.WalkSpeed = getgenv().Cfg.ws
        hum.JumpPower = getgenv().Cfg.jp
        hum.UseJumpPower = true
    end

    workspace.CurrentCamera.FieldOfView = getgenv().Cfg.fov

    if getgenv().Cfg.noclip then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end

    if getgenv().Cfg.fps then
        if setfpscap then setfpscap(120) end
    else
        if setfpscap then setfpscap(60) end
    end

    if getgenv().Cfg.fly then
        if not flying then startFly() end
        if flyLV and flyAV then
            local cam = workspace.CurrentCamera
            local dir = Vector3.new(0,0,0)

            if hum and hum.MoveDirection.Magnitude > 0 then
                dir = dir + hum.MoveDirection
            end

            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end

            if flyUp then
                dir = dir + Vector3.new(0,1,0)
            end

            if dir.Magnitude > 0 then
                dir = dir.Unit * getgenv().Cfg.flyspeed
            end

            flyLV.VectorVelocity = dir
            flyAV.CFrame = cam.CFrame
        end
    else
        if flying then stopFly() end
    end

    if getgenv().Cfg.antivoid and hrp then
        if hrp.Position.Y < -50 then
            hrp.CFrame = CFrame.new(hrp.Position.X, 100, hrp.Position.Z)
        end
    end

    if getgenv().Cfg.fling and hrp then
        hrp.CanCollide = false
        local myPos = hrp.Position
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp and plr.Character then
                local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                if tRoot then
                    local dist = (myPos - tRoot.Position).Magnitude
                    if dist < 8 then
                        hrp.CFrame = tRoot.CFrame
                        hrp.Velocity = Vector3.new(0,0,0)
                        hrp.RotVelocity = Vector3.new(0,0,0)
                        if hum then
                            hum.WalkSpeed = 200
                        end
                        hrp.CFrame = tRoot.CFrame * CFrame.new(0,0,-1)
                        hrp.Velocity = (tRoot.Position - myPos).Unit * 300
                        tRoot.Velocity = (tRoot.Position - myPos).Unit * 9999 + Vector3.new(0,4000,0)
                        tRoot.RotVelocity = Vector3.new(math.random(-9999,9999),math.random(-9999,9999),math.random(-9999,9999))
                    end
                end
            end
        end
    end

    if getgenv().Cfg.xray and not xrayOn then
        xrayOn = true
        xrayData = {}
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local skip = false
                for _,pl in ipairs(Players:GetPlayers()) do
                    if pl.Character and obj:IsDescendantOf(pl.Character) then skip = true break end
                end
                if not skip and obj.Transparency < 0.75 then
                    table.insert(xrayData, {obj, obj.Transparency})
                    obj.Transparency = 0.75
                end
            end
        end
    elseif not getgenv().Cfg.xray and xrayOn then
        xrayOn = false
        for _,d in ipairs(xrayData) do
            if d[1] and d[1].Parent then d[1].Transparency = d[2] end
        end
        xrayData = {}
    end
end)

