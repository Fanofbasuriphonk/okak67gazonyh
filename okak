                local isplayer = false
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr.Character and obj:IsDescendantOf(plr.Character) then
                        isplayer = true
                        break
                    end
                end
                if not isplayer and obj.Transparency < 0.7 then
                    table.insert(saved, {obj, obj.Transparency})
                    obj.Transparency = 0.7
                end
            end
        end
    elseif not getgenv().Config.Xray and xrayactive then
        xrayactive = false
        for _, data in pairs(saved) do
            if data[1] and data[1].Parent then
                data[1].Transparency = data[2]
            end
        end
        saved = {}
    end
end)

local function addesp(plr)
    if plr == LocalPlayer then return end
    local function create()
        local char = plr.Character
        if not char then return end
        local root = char:WaitForChild("HumanoidRootPart", 10)
        if not root then return end

        local h = Instance.new("Highlight", char)
        h.FillColor = getgenv().Config.ESPColor
        h.FillTransparency = 0.7
        h.OutlineColor = Color3.new(1, 1, 1)

        local bg = Instance.new("BillboardGui", char)
        bg.Adornee = root
        bg.Size = UDim2.new(0, 200, 0, 60)
        bg.AlwaysOnTop = true
        bg.StudsOffset = Vector3.new(0, 3.5, 0)

        local tl = Instance.new("TextLabel", bg)
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = Color3.new(1, 1, 1)
        tl.TextStrokeTransparency = 0
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 13

        local conn
        conn = RunService.RenderStepped:Connect(function()
            if not char or not char.Parent or not root or not root.Parent then
                conn:Disconnect()
                if h then h:Destroy() end
                if bg then bg:Destroy() end
                return
            end
            h.Enabled = getgenv().Config.High
            h.FillColor = getgenv().Config.ESPColor
            tl.Visible = getgenv().Config.ESP
            local myroot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local dist = myroot and math.floor((myroot.Position - root.Position).Magnitude) or 0
            tl.Text = plr.Name .. "\n[" .. dist .. " studs]"
        end)
    end
    if plr.Character then task.spawn(create) end
    plr.CharacterAdded:Connect(function() task.wait(1) create() end)
end

