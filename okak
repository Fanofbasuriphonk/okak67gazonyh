local function input(name, key, minv, maxv)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 65)
    f.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    f.Parent = scroll
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 25)
    l.Text = name .. ": " .. getgenv().Config[key]
    l.TextColor3 = Color3.new(1, 1, 1)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamSemibold
    l.Parent = f
    
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -20, 0, 30)
    box.Position = UDim2.new(0, 10, 0, 28)
    box.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    box.Text = tostring(getgenv().Config[key])
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Parent = f
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    
    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then
            num = math.clamp(num, minv, maxv)
            getgenv().Config[key] = num
            l.Text = name .. ": " .. num
        end
    end)
end

local function toggle(name, key)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 45)
    b.BackgroundColor3 = getgenv().Config[key] and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(45, 45, 45)
    b.Text = name .. ": " .. (getgenv().Config[key] and "ON" or "OFF")
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.Parent = scroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
    
    b.MouseButton1Click:Connect(function()
        getgenv().Config[key] = not getgenv().Config[key]
        b.BackgroundColor3 = getgenv().Config[key] and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(45, 45, 45)
        b.Text = name .. ": " .. (getgenv().Config[key] and "ON" or "OFF")
    end)
end

