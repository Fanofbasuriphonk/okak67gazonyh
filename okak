local function addinput(name, key, minv, maxv)
    local holder = Instance.new("Frame", scroll)
    holder.Size = UDim2.new(1, 0, 0, 60)
    holder.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    holder.BorderSizePixel = 0
    holder.LayoutOrder = nextorder()
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)

    local label = Instance.new("TextLabel", holder)
    label.Size = UDim2.new(1, -10, 0, 25)
    label.Position = UDim2.new(0, 10, 0, 2)
    label.BackgroundTransparency = 1
    label.Text = name .. ": " .. tostring(getgenv().Cfg[key])
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left

    local input = Instance.new("TextBox", holder)
    input.Size = UDim2.new(1, -20, 0, 28)
    input.Position = UDim2.new(0, 10, 0, 27)
    input.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    input.BorderSizePixel = 0
    input.Text = tostring(getgenv().Cfg[key])
    input.TextColor3 = Color3.fromRGB(255, 255, 255)
    input.Font = Enum.Font.Gotham
    input.TextSize = 14
    input.ClearTextOnFocus = true
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 8)

    input.FocusLost:Connect(function()
        local n = tonumber(input.Text)
        if n then
            n = math.clamp(math.floor(n), minv, maxv)
            getgenv().Cfg[key] = n
            input.Text = tostring(n)
            label.Text = name .. ": " .. tostring(n)
        else
            input.Text = tostring(getgenv().Cfg[key])
        end
    end)
end

local function addtoggle(name, key)
    local togbtn = Instance.new("TextButton", scroll)
    togbtn.Size = UDim2.new(1, 0, 0, 40)
    togbtn.BackgroundColor3 = getgenv().Cfg[key] and Color3.fromRGB(0, 160, 80) or Color3.fromRGB(50, 50, 50)
    togbtn.BorderSizePixel = 0
    togbtn.Text = name .. ": " .. (getgenv().Cfg[key] and "ON" or "OFF")
    togbtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    togbtn.Font = Enum.Font.GothamBold
    togbtn.TextSize = 14
    togbtn.LayoutOrder = nextorder()
    Instance.new("UICorner", togbtn).CornerRadius = UDim.new(0, 10)

    togbtn.MouseButton1Click:Connect(function()
        getgenv().Cfg[key] = not getgenv().Cfg[key]
        togbtn.BackgroundColor3 = getgenv().Cfg[key] and Color3.fromRGB(0, 160, 80) or Color3.fromRGB(50, 50, 50)
        togbtn.Text = name .. ": " .. (getgenv().Cfg[key] and "ON" or "OFF")
    end)
end

