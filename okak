local function create_input(txt, key, min, max)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 50)
    f.BackgroundTransparency = 1
    f.Parent = scroll
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 20)
    l.Text = txt .. ": " .. getgenv().S[key]
    l.TextColor3 = Color3.new(1, 1, 1)
    l.BackgroundTransparency = 1
    l.Parent = f
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, 25)
    box.Position = UDim2.new(0, 0, 0, 25)
    box.Text = tostring(getgenv().S[key])
    box.Parent = f
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(n, min, max)
            getgenv().S[key] = n
            l.Text = txt .. ": " .. n
        end
    end)
end

local function create_toggle(txt, key)
    local t = Instance.new("TextButton")
    t.Size = UDim2.new(1, 0, 0, 35)
    t.Text = txt .. ": " .. tostring(getgenv().S[key])
    t.Parent = scroll
    t.MouseButton1Click:Connect(function()
        getgenv().S[key] = not getgenv().S[key]
        t.Text = txt .. ": " .. tostring(getgenv().S[key])
    end)
end

create_input("WalkSpeed", "ws", 16, 500)
create_input("JumpPower", "jp", 50, 500)
create_input("FOV", "fov", 70, 200)
create_toggle("ESP", "esp")
create_toggle("Highlights", "h")

local function drag(o)
    local d, s, p
    o.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then d = true s = i.Position p = o.Position end end)
    uis.InputChanged:Connect(function(i) if d and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then local del = i.Position - s o.Position = UDim2.new(p.X.Scale, p.X.Offset + del.X, p.Y.Scale, p.Y.Offset + del.Y) end end)
    uis.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then d = false end end)
end
drag(main) drag(btn)

btn.MouseButton1Click:Connect(function() main.Visible = true btn.Visible = false end)
local close = Instance.new("TextButton")
close.Size = UDim2.new(0, 20, 0, 20)
close.Position = UDim2.new(1, -25, 0, 5)
close.Text = "X"
close.Parent = main
close.MouseButton1Click:Connect(function() main.Visible = false btn.Visible = true end)

local function apply_esp(p)
    if p == lp then return end
    local function setup(char)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end
        local hi = Instance.new("Highlight", char)
        local bg = Instance.new("BillboardGui", char)
        bg.Size = UDim2.new(0, 200, 0, 50)
        bg.Adornee = hrp
        bg.AlwaysOnTop = true
        bg.StudsOffset = Vector3.new(0, 3, 0)
        local tl = Instance.new("TextLabel", bg)
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = Color3.new(1, 1, 1)
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 12
        local c
        c = rs.RenderStepped:Connect(function()
            if char and char.Parent and hrp and hrp.Parent then
                hi.Enabled = getgenv().S.h
                tl.Visible = getgenv().S.esp
                local d = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and math.floor((hrp.Position - lp.Character.HumanoidRootPart.Position).Magnitude) or 0
                tl.Text = p.Name .. " [" .. d .. "s]"
            else
                c:Disconnect() hi:Destroy() bg:Destroy()
            end
        end)
    end
    if p.Character then setup(p.Character) end
    p.CharacterAdded:Connect(setup)
end

for _,v in pairs(plrs:GetPlayers()) do apply_esp(v) end
plrs.PlayerAdded:Connect(apply_esp)

rs.Heartbeat:Connect(function()
    if lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid.WalkSpeed = getgenv().S.ws
        lp.Character.Humanoid.JumpPower = getgenv().S.jp
    end
    cam.FieldOfView = getgenv().S.fov
end)
