    tb.Text = n .. ": " .. tostring(getgenv().S[k])
    tb.Parent = sc
    tb.MouseButton1Click:Connect(function()
        getgenv().S[k] = not getgenv().S[k]
        tb.Text = n .. ": " .. tostring(getgenv().S[k])
    end)
end

