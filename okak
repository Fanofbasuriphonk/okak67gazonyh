RunService.Heartbeat:Connect(function()
    local char = lp.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = getgenv().Cfg.ws
            hum.JumpPower = getgenv().Cfg.jp
            hum.UseJumpPower = true
        end
    end
    workspace.CurrentCamera.FieldOfView = getgenv().Cfg.fov

    if getgenv().Cfg.fps and setfpscap then
        setfpscap(120)
    elseif setfpscap then
        setfpscap(60)
    end

    if getgenv().Cfg.xray and not xrayOn then
        xrayOn = true
        xrayData = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local skip = false
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Character and obj:IsDescendantOf(plr.Character) then
                        skip = true
                        break
                    end
                end
                if not skip and obj.Transparency < 0.75 then
                    table.insert(xrayData, {obj, obj.Transparency})
                    obj.Transparency = 0.75
                end
            end
        end
    elseif not getgenv().Cfg.xray and xrayOn then
        xrayOn = false
        for _, d in ipairs(xrayData) do
            if d[1] and d[1].Parent then
                d[1].Transparency = d[2]
            end
        end
        xrayData = {}
    end
end)

local espConns = {}

local function makeESP(plr)
    if plr == lp then return end

    local function setup(char)
        if not char then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        if not hrp then return end

        if char:FindFirstChildOfClass("Highlight") then
            char:FindFirstChildOfClass("Highlight"):Destroy()
        end

        local hl = Instance.new("Highlight")
        hl.Name = "DeltaHL"
        hl.FillColor = getgenv().Cfg.color
        hl.FillTransparency = 0.7
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.Adornee = char
        hl.Parent = char

        local bb = Instance.new("BillboardGui")
        bb.Name = "DeltaBB"
        bb.Adornee = hrp
        bb.Size = UDim2.new(0, 200, 0, 50)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = char

        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3 = Color3.fromRGB(255, 255, 255)
        tl.TextStrokeTransparency = 0
        tl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        tl.Font = Enum.Font.GothamBold
        tl.TextSize = 13
        tl.TextScaled = false
        tl.Parent = bb

        if espConns[plr] then
            espConns[plr]:Disconnect()
        end

        espConns[plr] = RunService.RenderStepped:Connect(function()
            if not char or not char.Parent or not hrp or not hrp.Parent then
                if espConns[plr] then
                    espConns[plr]:Disconnect()
                    espConns[plr] = nil
                end
                return
            end

            hl.Enabled = getgenv().Cfg.high
            hl.FillColor = getgenv().Cfg.color
            bb.Enabled = getgenv().Cfg.esp

            local myhrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if myhrp then
                local dist = math.floor((myhrp.Position - hrp.Position).Magnitude)
                tl.Text = plr.Name .. "\n[" .. dist .. " studs]"
            else
                tl.Text = plr.Name
            end
        end)
    end

    if plr.Character then
        task.spawn(function()
            setup(plr.Character)
        end)
    end

    plr.CharacterAdded:Connect(function(char)
        task.wait(1)
        setup(char)
    end)
end

for _, v in ipairs(Players:GetPlayers()) do
    task.spawn(function()
        makeESP(v)
    end)
end

Players.PlayerAdded:Connect(function(plr)
    makeESP(plr)
end)

Players.PlayerRemoving:Connect(function(plr)
    if espConns[plr] then
        espConns[plr]:Disconnect()
        espConns[plr] = nil
    end
end)
